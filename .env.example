# ══════════════════════════════════════════════════════════════════════════════
# SBITIS Growth Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Choose "gemini" (faster/cheaper) or "claude" (stronger reasoning)
PRIMARY_LLM=gemini

# Gemini 2.5 Flash — primary model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Claude (used for heavy reasoning if PRIMARY_LLM=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# ── LangSmith ─────────────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=sbitis-growth-platform
LANGCHAIN_TRACING_V2=true

# Dataset names (auto-created if they don't exist)
LANGSMITH_DATASET_STRATEGY_CALLS=sbitis-strategy-calls
LANGSMITH_DATASET_SALES_TRAINING=sbitis-sales-training
LANGSMITH_DATASET_LEADERSHIP=sbitis-leadership-meetings
LANGSMITH_DATASET_TEAM_MEETINGS=sbitis-team-meetings
LANGSMITH_DATASET_CLIENT_REVIEWS=sbitis-client-reviews
LANGSMITH_DATASET_PARTNERSHIPS=sbitis-partnership-meetings

# ── Fireflies.ai ──────────────────────────────────────────────────────────────
FIREFLIES_API_KEY=your_fireflies_api_key_here
# How many hours back to look for new transcripts on each run
FIREFLIES_LOOKBACK_HOURS=25

# ── Meta Ads ──────────────────────────────────────────────────────────────────
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_long_lived_access_token_here
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXXXX
# Rolling window for reporting (days)
META_REPORT_DAYS=7

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Path to your service account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json
# The spreadsheet ID from the URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/
WAR_SHEET_ID=your_spreadsheet_id_here
AI_INTELLIGENCE_TAB=🧠 AI Intelligence
KPI_ADS_TAB=KPIs - Ads
# Comma-separated list of closer tab names
CLOSER_TABS=Hamza SBITI - Sales Tracking,Zineb Lahbabi - Sales Tracking,Chakir - Sales Tracking,Austin - Sales Tracking

# ── GoHighLevel ───────────────────────────────────────────────────────────────
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here

# ── Knowledge Base ────────────────────────────────────────────────────────────
# Comma-separated Google Drive folder IDs to index as knowledge base
# Get IDs from Drive URL: drive.google.com/drive/folders/THIS_PART
# Recommended structure on your Drive:
#   📁 SBITIS Knowledge Base/
#     📁 SOPs/
#     📁 Sales Frameworks/        ← Closing scripts, objection handling
#     📁 Training Docs/
#     📁 Onboarding Videos/       ← MP4 titles + descriptions indexed
#     📁 Ad Copy & Scripts/
#     📁 WhatsApp Sequences/
KB_FOLDER_IDS=folder_id_1,folder_id_2
KB_STORE_PATH=./knowledge_base_store
KB_ENABLED=true

# ── General ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to "true" to skip all writes (Google Sheets, LangSmith) for testing
DRY_RUN=false
